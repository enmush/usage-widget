<Window x:Class="UsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI usage"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnMouseDown">

    <Window.Resources>
        <!-- A bar is a track with a fill scaled from the left edge. -->
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Fill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="Width" Value="34" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Opened="OnMenuOpened">
            <MenuItem Header="Refresh now" Click="OnRefreshClick" />
            <MenuItem Header="Hide" Click="OnHideClick" />
            <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnStartupClick" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            CornerRadius="10" Padding="14,10,14,10">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="AI usage" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" />
                    <Ellipse x:Name="BusyDot" Width="5" Height="5" Margin="6,0,0,0" Fill="{StaticResource BandNormal}"
                             VerticalAlignment="Center" Visibility="Hidden" />
                </StackPanel>
            </Grid>

            <!-- Column captions -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="5-hour" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="3" Text="weekly" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="4" Text="next reset" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="tickets" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                        <Grid Height="26" Opacity="{Binding Opacity}" ToolTip="{Binding Details}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text=" !" Foreground="{StaticResource BandWarning}" FontWeight="Bold"
                                           Visibility="{Binding StaleVisibility}" />
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Track}" Visibility="{Binding SessionBarVisibility}">
                                    <Border Style="{StaticResource Fill}" Background="{Binding SessionBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding SessionFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource Pct}" />
                            </Grid>

                            <Grid Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Track}">
                                    <Border Style="{StaticResource Fill}" Background="{Binding WeeklyBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding WeeklyFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding WeeklyText}" Style="{StaticResource Pct}" />
                            </Grid>

                            <TextBlock Grid.Column="4" Text="{Binding ResetText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                            <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="6" Padding="5,0,5,1" Background="#2EC9A7FF"
                                    Visibility="{Binding TicketVisibility}">
                                <TextBlock Text="{Binding TicketText}" Foreground="{StaticResource Ticket}" FontSize="10.5" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding AnnouncementText}" ToolTip="{Binding AnnouncementDetails}"
                                   Visibility="{Binding AnnouncementVisibility}" Margin="86,-4,0,4"
                                   Foreground="{StaticResource Ticket}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
