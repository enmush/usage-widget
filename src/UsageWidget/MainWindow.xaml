<Window x:Class="UsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI usage" Icon="app.ico"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- A bar is a track with a fill scaled from the left edge. -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="Width" Value="34" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Flat buttons: transparent until hovered. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{StaticResource BandNormal}" />
        </Style>

        <!-- A checkbox drawn as a small rounded box with a tick. -->
        <Style x:Key="ShowCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource TextSecondary}" Background="Transparent">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="#FF202124" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BandNormal}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BandNormal}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Provider picker drawn as segmented pills. -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Padding="10,2" BorderThickness="1" BorderBrush="{StaticResource Hairline}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BandNormal}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Opened="OnMenuOpened">
            <MenuItem Header="Refresh now" Click="OnRefreshClick" />
            <MenuItem Header="Accounts…" Click="OnAccountsClick" />
            <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnStartupClick" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            CornerRadius="10" Padding="14,8,8,10" MouseLeftButtonDown="OnPanelMouseDown">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="AI usage" FontWeight="SemiBold" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" />
                    <Ellipse x:Name="BusyDot" Width="5" Height="5" Margin="6,0,0,0" Fill="{StaticResource BandNormal}"
                             VerticalAlignment="Center" Visibility="Hidden" />
                </StackPanel>
                <Button x:Name="GearButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Accounts" AutomationProperties.Name="Accounts" Click="OnAccountsClick" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE921;"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimizeClick" />
            </Grid>

            <!-- Usage view -->
            <StackPanel x:Name="UsageView" Margin="0,0,6,0">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="5-hour" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="weekly" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="next reset" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="tickets" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>

                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Height="26" Opacity="{Binding Opacity}" ToolTip="{Binding Details}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                        <TextBlock Text=" !" Foreground="{StaticResource BandWarning}" FontWeight="Bold"
                                                   Visibility="{Binding StaleVisibility}" />
                                    </StackPanel>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource BarTrack}" Visibility="{Binding SessionBarVisibility}">
                                            <Border Style="{StaticResource BarFill}" Background="{Binding SessionBrush}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding SessionFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource Pct}" />
                                    </Grid>

                                    <Grid Grid.Column="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource BarTrack}">
                                            <Border Style="{StaticResource BarFill}" Background="{Binding WeeklyBrush}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding WeeklyFraction}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding WeeklyText}" Style="{StaticResource Pct}" />
                                    </Grid>

                                    <TextBlock Grid.Column="4" Text="{Binding ResetText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                                    <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            CornerRadius="6" Padding="5,0,5,1" Background="#2EC9A7FF"
                                            Visibility="{Binding TicketVisibility}">
                                        <TextBlock Text="{Binding TicketText}" Foreground="{StaticResource Ticket}" FontSize="10.5" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding AnnouncementText}" ToolTip="{Binding AnnouncementDetails}"
                                           Visibility="{Binding AnnouncementVisibility}" Margin="86,-4,0,4"
                                           Foreground="{StaticResource Ticket}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoRowsHint" Visibility="Collapsed" Margin="0,6,0,2" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}"
                           Text="No accounts shown. Click the gear to add an account or show a hidden one." />
            </StackPanel>

            <!-- Accounts view -->
            <StackPanel x:Name="AccountsView" Visibility="Collapsed" Margin="0,0,6,0">
                <ItemsControl x:Name="AccountsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ShowCheck}" IsChecked="{Binding Shown, Mode=OneWay}"
                                          Tag="{Binding Index}" Checked="OnShowToggled" Unchecked="OnShowToggled" ToolTip="Show this account"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding ProviderName}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding FolderText}" ToolTip="{Binding FolderText}"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" FontSize="11" />
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                                        Tag="{Binding Index}" Click="OnRemoveClick" ToolTip="Remove this account"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="AccountsHint" Margin="0,4,0,4" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" />

                <!-- Add form -->
                <Border x:Name="AddForm" Visibility="Collapsed" Margin="0,6,0,0" Padding="10,8"
                        CornerRadius="8" Background="{StaticResource Track}">
                    <StackPanel>
                        <TextBlock Text="Add account" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel x:Name="ProviderPicker" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="ProviderClaude" Style="{StaticResource Pill}" Content="Claude" Tag="claude" GroupName="provider"
                                         IsChecked="True" Checked="OnProviderChanged" />
                            <RadioButton Style="{StaticResource Pill}" Content="Codex" Tag="codex" GroupName="provider"
                                         Checked="OnProviderChanged" />
                            <RadioButton Style="{StaticResource Pill}" Content="Antigravity" Tag="antigravity" GroupName="provider"
                                         Checked="OnProviderChanged" />
                        </StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource Caption}" />
                            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Field}" AutomationProperties.Name="Name" />
                        </Grid>
                        <Grid x:Name="FolderRow" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Login folder" Style="{StaticResource Caption}" />
                            <TextBox x:Name="FolderBox" Grid.Column="1" Style="{StaticResource Field}" AutomationProperties.Name="Login folder" />
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Browse…" Margin="4,0,0,0"
                                    Click="OnBrowseClick" />
                        </Grid>
                        <TextBlock x:Name="FolderHelp" Margin="86,-2,0,6" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="AddError" Foreground="{StaticResource BandDanger}" Margin="0,0,0,6"
                                   Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="OnCancelAddClick" />
                            <Button Style="{StaticResource AccentButton}" Content="Add" Click="OnConfirmAddClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddButton" Style="{StaticResource FlatButton}" Content="+ Add account" Click="OnAddClick" />
                        <Button Style="{StaticResource FlatButton}" Content="Detect logins" Click="OnDetectClick" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Content="Done" Click="OnDoneClick" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
