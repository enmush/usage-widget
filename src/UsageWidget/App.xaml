<Application x:Class="UsageWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#F7202124" />
        <SolidColorBrush x:Key="Hairline" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Track" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="BandNormal" Color="#5CC8FF" />
        <SolidColorBrush x:Key="BandWarning" Color="#FFC24A" />
        <SolidColorBrush x:Key="BandDanger" Color="#FF6B6B" />
        <SolidColorBrush x:Key="Ticket" Color="#C9A7FF" />
    </Application.Resources>
</Application>
